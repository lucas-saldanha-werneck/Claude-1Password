# ~/.claude/.env.tpl — read by op-env. Secret REFERENCES only, never values.
# Format:  VARIABLE=op://<Vault>/<Item>/<field>
# Find a reference: 1Password app > item field > (⋯) > "Copy Secret Reference".
# Add one with:      op-store <Item>        (prints the op:// line to paste here)
#
# APIFY_TOKEN=op://Claude/Apify/credential
# GITHUB_TOKEN=op://Claude/GitHub PAT/credential
# UNIFI_USER=op://Claude/UniFi/username
# UNIFI_PASS=op://Claude/UniFi/password
