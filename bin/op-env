#!/bin/bash
# op-env — load 1Password secrets into environment variables and exec a command
#          with the TTY preserved. One `op` call = one biometric prompt per session.
#
# Usage:
#   op-env <command> [args...]          e.g.  op-env claude
#   op-env --tpl <file> <command>       use another template
#   op-env --list                       print WHICH keys would be loaded (names only, no values)
#   op-env --check                      test op + template + unlock, run nothing
#
# Default template: ~/.claude/.env.tpl  (op:// references only, never values)
#   APIFY_TOKEN=op://Claude/Apify/credential
#
# Why not `op run -- claude`?  The child of `op run` gets no TTY, so Claude Code
# falls back to --print mode. This wrapper resolves once, exports, then `exec`s.
# Pattern from the community (gist by DAESA24), hardened: NUL-delimited transport
# (multi-line values survive), only template keys are exported, template is validated.

set +xv   # never trace: an inherited -x / SHELLOPTS=xtrace would print values
set -u
TPL="${OP_ENV_TPL:-$HOME/.claude/.env.tpl}"
MODE=run

while [ $# -gt 0 ]; do
  case "$1" in
    --tpl)   TPL="$2"; shift 2 ;;
    --list)  MODE=list; shift ;;
    --check) MODE=check; shift ;;
    -h|--help) sed -n '2,15p' "$0"; exit 0 ;;
    --) shift; break ;;
    *) break ;;
  esac
done

die() { printf 'op-env: %s\n' "$*" >&2; exit 1; }

command -v op >/dev/null 2>&1 || die "op not found. macOS: brew install --cask 1password-cli | https://developer.1password.com/docs/cli/get-started/"
[ -f "$TPL" ] || die "template not found: $TPL  (see templates/env.tpl.example)"

# Validate the template: every active line must be  NAME=op://...  with NAME a shell identifier.
KEYS=()
lineno=0
while IFS= read -r line || [ -n "$line" ]; do
  lineno=$((lineno+1))
  line="${line%$'\r'}"   # CRLF templates (Windows editors)
  case "$line" in ''|\#*|[[:space:]]*\#*) continue ;; esac
  [[ "$line" =~ ^[[:space:]]*$ ]] && continue
  key="${line%%=*}"; val="${line#*=}"
  key="${key//[[:space:]]/}"
  [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "$TPL:$lineno: '$key' is not a valid variable name"
  [[ "$val" == op://* ]] || die "$TPL:$lineno: value of $key must be an op:// reference (never a literal secret)"
  KEYS+=("$key")
done < "$TPL"
TOTAL=${#KEYS[@]}

if [ "$MODE" = list ]; then
  [ "$TOTAL" -gt 0 ] && printf '%s\n' "${KEYS[@]}"
  exit 0
fi

# An empty template is allowed: nothing to load, just run the command (useful right after install).
if [ "$TOTAL" -eq 0 ] && [ "$MODE" = run ]; then
  [ $# -gt 0 ] || die "missing command. e.g.: op-env claude"
  printf 'op-env: template has no active keys (%s); running without secrets\n' "$TPL" >&2
  exec "$@"
fi

# Resolve once. Inside `op run` the variables are set; print them NUL-delimited so
# newlines inside a value survive, and only the template's keys are ever printed.
resolve() {
  op run --no-masking --env-file "$TPL" -- bash -c '
    for k in "$@"; do
      eval "v=\${$k-__OP_ENV_UNSET__}"
      [ "$v" = "__OP_ENV_UNSET__" ] && continue
      case "$v" in op://*) continue ;; esac   # unresolved reference: skip, do not export a fake value
      printf "%s\0%s\0" "$k" "$v"
    done' _ "${KEYS[@]}" 2>/dev/null
}

if [ "$MODE" = check ]; then
  printf 'op:        %s\n' "$(op --version)"
  printf 'template:  %s (%s keys)\n' "$TPL" "$TOTAL"
  # `op whoami` fails under app integration ("account is not signed in"); vault list proves the session
  if op vault list >/dev/null 2>&1; then
    printf 'account:   %s\n' "$(op account list 2>/dev/null | awk 'NR==2{print $2" ("$1")"}')"
  else
    printf 'account:   NOT connected. 1Password app > Settings > Developer > "Integrate with 1Password CLI" (or set OP_SERVICE_ACCOUNT_TOKEN)\n'
    exit 1
  fi
  [ "$TOTAL" -eq 0 ] && { printf 'resolved:  0 of 0 keys (template has no active keys yet; add one with op-store)\n'; exit 0; }
  n=0
  while IFS= read -r -d '' k && IFS= read -r -d '' v; do n=$((n+1)); done < <(resolve)
  printf 'resolved:  %s of %s keys\n' "$n" "$TOTAL"
  if [ "$n" -ne "$TOTAL" ]; then
    # show op's own error (it names the bad reference; it never prints values)
    err=$(op run --env-file "$TPL" -- true 2>&1 >/dev/null | head -3)
    [ -n "$err" ] && printf 'op says:   %s\n' "$err"
    exit 1
  fi
  exit 0
fi

[ $# -gt 0 ] || die "missing command. e.g.: op-env claude"

loaded=0
while IFS= read -r -d '' k && IFS= read -r -d '' v; do
  export "$k=$v"
  loaded=$((loaded+1))
done < <(resolve)

if [ "$loaded" -eq 0 ]; then
  die "no keys loaded. 1Password locked or CLI not integrated? Try: op-env --check"
fi
[ "$loaded" -lt "$TOTAL" ] && printf 'op-env: warning: %s of %s keys loaded (a reference did not resolve; run op-env --check)\n' "$loaded" "$TOTAL" >&2

# A service-account token must not travel into the launched command: it would give every `op` call
# inside the session full vault access with no prompt. Set OP_ENV_KEEP_SA=1 to keep it on purpose.
[ "${OP_ENV_KEEP_SA:-}" = 1 ] || unset OP_SERVICE_ACCOUNT_TOKEN

exec "$@"
