#!/bin/bash
# secret-dialog — native "enter a secret" dialog with a hidden field and an eye (reveal toggle).
#                 Picks the native backend for the OS. Prints the text to stdout, nothing else.
#
# Usage: secret-dialog "Title" "Message" [--visible] [--timeout SECONDS]
# Exit:  0 ok · 2 cancelled · 3 timed out · 4 empty · 5 no backend available
#
# Backends (in order):
#   macOS    secret-dialog-macos   (Swift, compiled by install.sh)   eye: yes
#            osascript             (AppleScript, built in)           eye: no
#   Windows  secret-dialog-windows.ps1 (PowerShell + WinForms)       eye: yes
#   Linux    kdialog --password    (KDE, KF ≥ 5.84)                  eye: yes
#            secret-dialog-gtk.py  (GTK4 Gtk.PasswordEntry / GTK3)   eye: yes
#            zenity --entry --hide-text                              eye: no
#   any      read -s in the terminal (only if stdin is a TTY)        eye: no
#
# Set SECRET_DIALOG_BACKEND=macos|osascript|windows|kdialog|gtk|zenity|tty to force one.

set +xv   # never trace: the collected value passes through this script
set -u
TMO=$(command -v timeout || command -v gtimeout || true)   # GNU timeout; absent on stock macOS (brew coreutils = gtimeout)
# resolve our own location through any chain of symlinks (relative targets included)
src="$0"
while [ -L "$src" ]; do
  d="$(cd "$(dirname "$src")" && pwd)"; src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$d/$src" ;; esac
done
HERE="$(cd "$(dirname "$src")" && pwd)"
TITLE="${1:-Secret}"; MESSAGE="${2:-}"; shift 2 2>/dev/null || shift $#
VISIBLE=0; TIMEOUT=300
while [ $# -gt 0 ]; do
  case "$1" in
    --visible) VISIBLE=1; shift ;;
    --timeout) TIMEOUT="$2"; shift 2 ;;
    *) shift ;;
  esac
done
[[ "$TIMEOUT" =~ ^[0-9]+$ ]] || TIMEOUT=300

os="$(uname -s 2>/dev/null)"
case "$os" in
  Darwin) platform=macos ;;
  MINGW*|MSYS*|CYGWIN*) platform=windows ;;
  Linux) [ -n "${WSL_DISTRO_NAME:-}" ] && platform=wsl || platform=linux ;;
  *) platform=other ;;
esac

try_macos() {
  [ -x "$HERE/secret-dialog-macos" ] || return 5
  local v=""; [ "$VISIBLE" = 1 ] && v="--visible"
  "$HERE/secret-dialog-macos" "$TITLE" "$MESSAGE" $v --timeout "$TIMEOUT"
}
try_osascript() {
  command -v osascript >/dev/null || return 5
  # title/message/flags go in as argv of a FIXED AppleScript program: never interpolated into source
  local r
  r=$(osascript - "$TITLE" "$MESSAGE" "$VISIBLE" "$TIMEOUT" <<'APPLESCRIPT' 2>/dev/null
on run argv
  set t to item 1 of argv
  set m to item 2 of argv
  set vis to item 3 of argv
  set secs to (item 4 of argv) as integer
  tell application "System Events" to activate
  if vis is "1" then
    set r to display dialog m default answer "" with title t with icon caution giving up after secs
  else
    set r to display dialog m default answer "" with title t with icon caution with hidden answer giving up after secs
  end if
  if gave up of r then return "__TIMEOUT__"
  return text returned of r
end run
APPLESCRIPT
  ) || return 2
  [ "$r" = "__TIMEOUT__" ] && return 3
  [ -n "$r" ] || return 4
  printf '%s' "$r"
}
try_windows() {
  local ps=""
  for c in pwsh.exe powershell.exe pwsh powershell; do command -v "$c" >/dev/null 2>&1 && { ps="$c"; break; }; done
  [ -n "$ps" ] || return 5
  local script="$HERE/secret-dialog-windows.ps1"
  [ "$platform" = wsl ] && command -v wslpath >/dev/null && script="$(wslpath -w "$script")"
  local v="0"; [ "$VISIBLE" = 1 ] && v="1"
  "$ps" -NoProfile -STA -ExecutionPolicy Bypass -File "$script" -Title "$TITLE" -Message "$MESSAGE" -Visible "$v" -Timeout "$TIMEOUT"
}
try_kdialog() {
  command -v kdialog >/dev/null || return 5
  local r rc
  if [ "$VISIBLE" = 1 ]; then
    r=$(${TMO:+"$TMO" "$TIMEOUT"} kdialog --title "$TITLE" --inputbox "$MESSAGE") ; rc=$?
  else
    r=$(${TMO:+"$TMO" "$TIMEOUT"} kdialog --title "$TITLE" --password "$MESSAGE") ; rc=$?
  fi
  [ $rc -eq 124 ] && return 3
  [ $rc -eq 0 ] || return 2
  [ -n "$r" ] || return 4
  printf '%s' "$r"
}
try_gtk() {
  command -v python3 >/dev/null || return 5
  python3 -c 'import gi' 2>/dev/null || return 5
  local v=""; [ "$VISIBLE" = 1 ] && v="--visible"
  python3 "$HERE/secret-dialog-gtk.py" "$TITLE" "$MESSAGE" $v --timeout "$TIMEOUT"
}
try_zenity() {
  command -v zenity >/dev/null || return 5
  local r rc
  if [ "$VISIBLE" = 1 ]; then
    r=$(${TMO:+"$TMO" "$TIMEOUT"} zenity --entry --title="$TITLE" --text="$MESSAGE"); rc=$?
  else
    r=$(${TMO:+"$TMO" "$TIMEOUT"} zenity --entry --hide-text --title="$TITLE" --text="$MESSAGE"); rc=$?
  fi
  [ $rc -eq 124 ] && return 3
  [ $rc -eq 0 ] || return 2
  [ -n "$r" ] || return 4
  printf '%s' "$r"
}
try_tty() {
  [ -t 0 ] || return 5
  local r
  printf '%s\n%s\n' "$TITLE" "$MESSAGE" >&2
  if [ "$VISIBLE" = 1 ]; then read -r -p "> " r </dev/tty; else read -r -s -p "(hidden) > " r </dev/tty; printf '\n' >&2; fi
  [ -n "$r" ] || return 4
  printf '%s' "$r"
}

run() { "try_$1"; local rc=$?; [ $rc -eq 5 ] && return 5; exit $rc; }

if [ -n "${SECRET_DIALOG_BACKEND:-}" ]; then
  run "$SECRET_DIALOG_BACKEND"; exit 5
fi
case "$platform" in
  macos)   run macos; run osascript ;;
  windows|wsl) run windows ;;
  linux)
    if [ "${XDG_CURRENT_DESKTOP:-}" = "KDE" ] || [ -n "${KDE_FULL_SESSION:-}" ]; then run kdialog; run gtk; else run gtk; run kdialog; fi
    run zenity ;;
esac
run tty
printf 'secret-dialog: no dialog backend available on %s\n' "$os" >&2
exit 5
